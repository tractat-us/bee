<!--
  The host's logging: INFO to stderr, with kuilt and Ktor at WARN, so a Playwright run's piped
  host output isn't buried in DEBUG noise. Without this file logback logs everything at DEBUG.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="us.tractat.kuilt" level="WARN"/>
    <logger name="io.ktor" level="WARN"/>
    <!-- The MCP SDK, for the bridges the host runs over HTTP: INFO on every session and tool. -->
    <logger name="io.modelcontextprotocol" level="WARN"/>
    <!-- The SDK names its registries' loggers outside its package, one per feature kind. -->
    <logger name="FeatureRegistry[Tool]" level="WARN"/>
    <logger name="FeatureRegistry[Prompt]" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
