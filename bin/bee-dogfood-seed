#!/usr/bin/env bash
# bee-dogfood-seed: draw bee's plan, morning report and open decisions on the dogfood board.
#
#   bee-dogfood-seed [--host <url>] [--name <agent>] [--reports <dir>] [--no-github]
#
# Joins the board bin/bee-dogfood started, over HTTP MCP as the agent `dogfood`, and draws three
# surfaces from this checkout: Plan (docs/project/plan.yaml as a Board), Morning report (the newest
# morning-report*.md in the main checkout) and Decisions (open issues and PRs labelled
# decision-needed or needs-design, through gh). Each is replaced whole under the same id, so run it
# again whenever the files change. The board's port comes from ~/.bee-dogfood/host.log
# (BEE_DOGFOOD_HOME), else 8240 (BEE_DOGFOOD_PORT).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/.." && pwd)
home=${BEE_DOGFOOD_HOME:-$HOME/.bee-dogfood}

case " $* " in
    *" -h "*|*" --help "*) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

if [ -z "${JAVA_HOME:-}" ] || ! "$JAVA_HOME/bin/java" -version 2>&1 | grep -q 'version "25'; then
    export JAVA_HOME="$HOME/.sdkman/candidates/java/25.0.5.0+8-tem"
fi
[ -x "$JAVA_HOME/bin/java" ] || { echo "No Java 25 at $JAVA_HOME. Set JAVA_HOME to a JDK 25." >&2; exit 1; }

# Build the seeder when it's missing or older than its sources.
seeder=$root/bee-dogfood/build/install/bee-dogfood/bin/bee-dogfood
jar=$root/bee-dogfood/build/install/bee-dogfood/lib/bee-dogfood.jar
if [ ! -x "$seeder" ] || [ -n "$(find "$root/bee-dogfood" -path "$root/bee-dogfood/build" -prune -o -type f -newer "$jar" -print -quit)" ]; then
    echo "Building the dogfood seeder (./gradlew :bee-dogfood:installDist)…" >&2
    (cd "$root" && ./gradlew :bee-dogfood:installDist --no-watch-fs --console=plain -q) >&2
fi

port=${BEE_DOGFOOD_PORT:-8240}
if [ -f "$home/host.log" ]; then
    logged=$(sed -n 's/.*bee host on http:\/\/[^:]*:\([0-9]*\)\/.*/\1/p' "$home/host.log" | tail -1)
    [ -n "$logged" ] && port=$logged
fi

# Morning reports are session scratch, never committed: they live in the main checkout, which a
# worktree shares its .git with.
common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "$root/.git")
reports=$(dirname "$common")

exec "$seeder" --host "http://127.0.0.1:$port" --repo "$root" --reports "$reports" "$@"
