#!/usr/bin/env bash
# bee-bundle: build a bee kit someone can use with no JDK and no checkout.
#
#   bin/bee-bundle            # writes build/kit/bee-kit-<os>-<arch>.zip
#
# The kit holds the bridge (bee-mcp), the host (bee-host), a trimmed Java 25 runtime made with
# jlink, and the bee-up and bee-join launchers. It runs only on this machine's OS and CPU: a kit
# built on an Apple-silicon Mac is for Apple-silicon Macs.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
java_home=${JAVA_HOME:-$HOME/.sdkman/candidates/java/25.0.5.0+8-tem}
"$java_home/bin/java" -version 2>&1 | grep -q 'version "25' || java_home=$HOME/.sdkman/candidates/java/25.0.5.0+8-tem

os=$(uname -s | tr '[:upper:]' '[:lower:]')
arch=$(uname -m)
name="bee-kit-$os-$arch"
out="$root/build/kit"
kit="$out/$name"

# jdeps can't trace every reflective load in Ktor, Netty and Logback, so this list is generous:
# a missing module only fails at run time, on the coworker's laptop.
# --no-watch-fs: file-system watching can miss a source change and ship a stale page bundle
# (tractat-us/bee#102), and a kit is the build nobody checks before handing it on.
modules=java.base,java.desktop,java.instrument,java.logging,java.management,java.naming,java.net.http,java.sql,java.xml,jdk.crypto.ec,jdk.httpserver,jdk.management,jdk.unsupported,jdk.zipfs

(cd "$root" && JAVA_HOME=$java_home ./gradlew :bee-host:installDist :bee-mcp:installDist --no-watch-fs --console=plain -q)
rm -rf "$kit" "$out/$name.zip"
mkdir -p "$kit"
"$java_home/bin/jlink" --add-modules "$modules" --strip-debug --no-header-files --no-man-pages \
    --compress zip-6 --output "$kit/runtime"
cp -R "$root/bee-mcp/build/install/bee-mcp" "$root/bee-host/build/install/bee-host" "$kit/"
cp "$root/bin/bee-env" "$root/bin/bee-up" "$root/bin/bee-join" "$root/bin/bee-session-start-hook" "$kit/"
cat > "$kit/README.txt" <<'EOF'
bee kit: a shared board for people and their Claude sessions.

Join someone's board (they ran bee-up and sent you a link):
    ./bee-join 'http://<their machine>:8233/?k=<key>' --name <you>
Then start Claude as it prints, and type /mcp__bee__whiteboard.

Run your own board:
    ./bee-up --name <you>

macOS may refuse to run files from a downloaded zip. If it does:
    xattr -dr com.apple.quarantine .
EOF
(cd "$out" && zip -qr "$name.zip" "$name")
echo "$out/$name.zip ($(du -h "$out/$name.zip" | cut -f1))"
