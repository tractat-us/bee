#!/usr/bin/env bash
# bee-telemetry: print what this machine's bee processes recorded, as one timeline.
#
#   bee-telemetry [--role host|bridge] [--peer <name>] [--since <10m>] [--tail <n>] [--json]
#                 [--home <dir>] [--dir <telemetry dir>]...
#
# Reads the host's telemetry (<BEE_HOME>/host/telemetry) and each bridge's
# (<BEE_HOME>/telemetry/bridge-*), oldest first. It only reads: a running host or bridge is never
# touched. BEE_HOME defaults to ~/.bee, as for bee-up.
set -euo pipefail
. "$(dirname "$0")/bee-env"

export BEE_HOME=$bee_home
exec "$JAVA_HOME/bin/java" -Dlogback.statusListenerClass=ch.qos.logback.core.status.NopStatusListener -Dkotlin-logging.logStartupMessage=false -cp "$(dirname "$bee_host")/../lib/*" us.tractat.bee.telemetry.TimelineMainKt "$@"
